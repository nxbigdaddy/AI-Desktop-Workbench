AIW_ENVIRONMENT=development
AIW_DATABASE_URL=sqlite:///runtime-data/platform.db
AIW_API_BASE_URL=http://127.0.0.1:8765
AIW_ENABLE_FAKE_WECOM=true
AIW_SESSION_IDLE_DAYS=10
AIW_SESSION_ABSOLUTE_DAYS=0
AIW_AUTH_TRANSACTION_TTL_SECONDS=300
AIW_PROMPT_RETENTION_DAYS=180

# Real WeCom integration is intentionally blank until company configuration exists.
AIW_WECOM_CORP_ID=
AIW_WECOM_AGENT_ID=
# Development only. Production should resolve AIW_WECOM_SECRET_REF via Secret Manager.
AIW_WECOM_SECRET=
AIW_WECOM_SECRET_REF=
AIW_WECOM_CALLBACK_URL=

# Model credentials must be injected locally or by Secret Manager, never committed.
AIW_MODEL_PROXY_BASE_URL=
AIW_MODEL_PROXY_CREDENTIAL_REF=
